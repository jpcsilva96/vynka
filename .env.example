# Vynka environment template
# Copy this file to .env and fill the values locally or in the deployment platform.
# Never commit real secrets.

# Public Supabase values exposed to the browser by Vite.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side Supabase values used during SSR/server functions.
# SUPABASE_PUBLISHABLE_KEY is public, but keep it here too because server code reads it.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Secret server-side key. Do not expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Master bootstrap credentials used only when provisioning the first platform user.
MASTER_EMAIL=
MASTER_PASSWORD=

# Legacy aliases still accepted by the bootstrap code.
EMAIL_MASTER=
SENHA_MASTER=
